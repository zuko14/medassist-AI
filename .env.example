# Meta WhatsApp Cloud API
WHATSAPP_TOKEN=your_permanent_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_VERIFY_TOKEN=your_custom_verify_string
WHATSAPP_API_VERSION=v22.0
WABA_DISPLAY_NAME=YourHospitalName

# OpenRouter AI (Primary MedAssist LLM Provider)
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=deepseek/deepseek-chat

# Groq AI (Deprecated Fallback)
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# Supabase
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Hospital Config
HOSPITAL_NAME=City Care Hospital
HOSPITAL_EMERGENCY_NUMBER=108
HOSPITAL_STAFF_ALERT_NUMBER=  # Optional — WhatsApp number for emergency staff alerts
HOSPITAL_PHONE=+919876543210
HOSPITAL_MAPS_LINK=https://maps.google.com/?q=YourHospitalLocation
HOSPITAL_WEBSITE=https://yourhospital.com
HOSPITAL_PRIVACY_POLICY_URL=https://yourhospital.com/privacy
HOSPITAL_ADDRESS=Plot 12, Hitech City, Hyderabad, Telangana 500081
HOSPITAL_LANDMARK=Near Cyber Towers
BOOKING_REF_PREFIX=MC

# App
APP_ENV=production
APP_PORT=8000
LOG_LEVEL=INFO

# Admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_password

# Platform Owner Dashboard (/platform-panel) — cross-hospital revenue & usage.
# Leave blank to disable the dashboard (returns 503). Must be set explicitly —
# there is no working default; do not reuse ADMIN_USERNAME/ADMIN_PASSWORD.
OWNER_USERNAME=
OWNER_PASSWORD=

# Security
META_APP_SECRET=your_meta_app_secret_from_developer_console
ADMIN_SECRET=your_admin_secret_for_clinic_management
META_VERIFY_TOKEN=your_meta_verify_token

# ABDM / ABHA Integration (Ayushman Bharat Digital Mission)
ABDM_CLIENT_ID=your_abdm_client_id
ABDM_CLIENT_SECRET=your_abdm_client_secret
ABDM_BASE_URL=https://abhasbx.abdm.gov.in/abha/api

# Data Retention (NMC + DPDP Compliance)
CLINICAL_RETENTION_YEARS=7
CONVERSATION_PURGE_DAYS=30

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
BOOKING_FEE_PAISE=50000
BOOKING_HOLD_MINUTES=10
REFUND_WINDOW_HOURS=4

# Integration Connectors (MocDoc, CallMedex, etc.)
INTEGRATION_SECRET=your_integration_secret_for_internal_api
CALLMEDEX_BEARER_TOKEN=your_callmedex_bearer_token
HMAC_SIGNATURE_SECRET=your_hmac_signature_secret
CONNECTOR_ENCRYPTION_KEY=your_fernet_key_for_encrypting_hmis_passwords
MEDASSIST_URL=http://localhost:8000

# WhatsApp Template Names (Meta-approved utility templates)
# Required for sending lab reports to patients outside the 24h session window
LAB_REPORT_TEMPLATE_NAME=lab_report_delivery
# Optional. A Meta template send does NOT open the 24h customer-service
# window, so outside that window the AI summary can only reach the patient
# inside the template itself. Point this at an APPROVED template with three
# body variables ({{1}} patient name, {{2}} report name, {{3}} AI summary)
# and reports start going out with their summary. Left empty, delivery falls
# back to the 2-variable template above and the report is recorded as
# ai_summary_sent = false rather than silently claiming a summary was sent.
LAB_REPORT_SUMMARY_TEMPLATE_NAME=

# ── Post-visit patient follow-up ─────────────────────────────────────────
# Platform defaults. Each clinic overrides these from the admin panel
# (Hospital Profile -> Patient Follow-ups); those values win.
FOLLOWUP_ENABLED_DEFAULT=true
FOLLOWUP_DAYS_AFTER_VISIT=1
# Built-in follow-up template ({{1}} first name, {{2}} hospital phone).
FOLLOWUP_TEMPLATE_NAME=post_appointment_followup
# Optional. A follow-up always lands outside WhatsApp's 24h reply window, so
# Meta only allows an approved template. To send a clinic's OWN wording, get
# a template approved with two variables ({{1}} first name, {{2}} message)
# and name it here. Empty = built-in template is used and any custom message
# configured in the admin panel is NOT delivered (logged, never claimed).
FOLLOWUP_MESSAGE_TEMPLATE_NAME=
# Optional — for connector admin alerts outside the 24h window
ADMIN_ALERT_TEMPLATE_NAME=

# ── Admin panel sessions (AUDIT-P1-2) ────────────────────────────────────
# The panel logs in via POST /admin/login and receives a revocable HttpOnly
# session cookie. HTTP Basic still works for API clients and scripts.
# Requires migration 067_admin_sessions.sql to be applied first; without it
# login falls back to Basic automatically rather than locking admins out.
ADMIN_SESSION_HOURS=12

# ── Walk-in report safety gate (AUDIT-P1-1) ──────────────────────────────
# Hold lab reports whose phone number is not registered with the clinic for
# staff review instead of delivering the PDF automatically. The number is
# typed by a receptionist into a third-party HMIS and nothing in our own data
# corroborates it belongs to the named patient; one wrong digit is an
# irreversible disclosure. Set false ONLY for a diagnostic centre that is
# almost entirely walk-in and has accepted that risk in writing.
HOLD_UNKNOWN_PHONE_REPORTS=true
