+    c = Conv(t, lang="te-IN")
+    out = asyncio.run(c.engine.emergency(c.state))
+    txt = c.text(out)
+    assert "108" in txt and "040-12345678" in txt and out.control == "transfer"
+    out = c.engine.clinical(new_state("en-IN"))
