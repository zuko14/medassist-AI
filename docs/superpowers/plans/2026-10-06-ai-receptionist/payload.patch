+# Collapsed onto the workflow that serves them.
+WORKFLOW_OF = {
+    "BOOK_APPOINTMENT": "BOOKING", "DOCTOR_AVAILABILITY": "BOOKING", "FOLLOW_UP_APPOINTMENT": "BOOKING",
