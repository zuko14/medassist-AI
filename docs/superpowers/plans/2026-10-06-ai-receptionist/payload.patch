+// ═══════ AI RECEPTIONIST (migration 098) ═══════
+let vcState = { tab: 'live', testCall: null, liveTimer: null };
+const VC_MONEY = p => (p === null || p === undefined) ? '—' : '₹' + (Number(p) / 100).toFixed(0);
+const VC_TIME = t => t ? new Date(t).toLocaleString('en-IN', { day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit' }) : '—';
+
+async function loadVoicePage() {
+    vcTab(vcState.tab);
+    try {
+        const [a, u] = await Promise.all([api('/admin/voice/analytics?days=7'), api('/admin/voice/usage')]);
+        document.getElementById('vc-s-calls').textContent = a.total_calls ?? 0;
+        document.getElementById('vc-s-auto').textContent = a.autonomy_overall === null ? '—' : a.autonomy_overall + '%';
+        document.getElementById('vc-s-handoff').textContent = (a.by_status || {}).handed_off || 0;
+        document.getElementById('vc-s-quality').textContent = a.avg_quality === null ? '—' : a.avg_quality;
+        document.getElementById('vc-s-cost').textContent = u.rates_configured ? VC_MONEY(u.cost_paise)
+            + (u.budget_paise ? ' / ' + VC_MONEY(u.budget_paise) : '') : 'rates not set';
+    } catch (e) { /* tabs show their own errors */ }
+}
+
+function vcTab(tab) {
+    vcState.tab = tab;
+    clearInterval(vcState.liveTimer);
+    document.querySelectorAll('[data-vtab]').forEach(b => b.classList.toggle('btn-accent', b.dataset.vtab === tab));
+    document.getElementById('vcDetail').hidden = true;
+    ({ live: vcLive, calls: vcCalls, analytics: vcAnalytics, outbound: vcOutbound, knowledge: vcKnowledge,
+       settings: vcSettings, test: vcTest })[tab]();
+}
+
+function vcCallRows(calls, emptyText) {
+    if (!calls.length) return emptyState('info', emptyText);
+    return `<div class="table-wrap"><table><thead><tr><th>Call</th><th>Caller</th><th>Language</th><th>Request</th><th>Outcome</th><th>Status</th><th>Started</th></tr></thead><tbody>`
+        + calls.map(c => `<tr style="cursor:pointer" onclick="vcOpen('${esc(c.id)}')"><td>${esc(c.call_ref)}<div class="lead-sub">${esc(c.direction)}</div></td>`
+        + `<td>${esc(c.caller_phone)}</td><td>${esc(c.language)}</td><td>${esc(c.current_workflow || c.primary_intent || '—')}</td>`
+        + `<td>${esc(c.outcome || c.waiting_for || '—')}</td><td>${badge(c.status)}</td><td>${esc(VC_TIME(c.started_at))}</td></tr>`).join('')
+        + '</tbody></table></div>';
+}
+
+async function vcLive() {
+    const pane = document.getElementById('vcPane');
+    const draw = async () => {
+        try {
+            const d = await api('/admin/voice/live');
+            if (vcState.tab !== 'live') return;
+            pane.innerHTML = '<div class="lead-card-title">Calls in progress (refreshes every 5 s)</div>'
+                + vcCallRows(d.calls || [], 'No call in progress right now.');
+        } catch (e) { pane.innerHTML = emptyState('warning', esc(e.message)); }
+    };
+    pane.innerHTML = loading();
+    await draw();
+    vcState.liveTimer = setInterval(draw, 5000);
+}
+
+async function vcCalls() {
+    const pane = document.getElementById('vcPane');
+    pane.innerHTML = `<div class="appt-search" role="search"><input type="search" class="search-bar" id="vcQ" maxlength="30" placeholder="Search by call number or phone" aria-label="Search calls" onkeydown="if(event.key==='Enter')vcCalls()"></div><div id="vcList">${loading()}</div>`;
+    const q = (document.getElementById('vcQ') || {}).value || '';
+    try {
+        const d = await api('/admin/voice/calls?days=30&limit=100' + (q ? '&q=' + encodeURIComponent(q) : ''));
+        document.getElementById('vcList').innerHTML = vcCallRows(d.calls || [], 'No calls yet.');
+    } catch (e) { document.getElementById('vcList').innerHTML = emptyState('warning', esc(e.message)); }
+}
+
+function vcJson(o) { return `<pre style="white-space:pre-wrap;font-size:.78rem;margin:0">${esc(JSON.stringify(o ?? {}, null, 2))}</pre>`; }
+
+async function vcOpen(id) {
+    const el = document.getElementById('vcDetail');
+    el.hidden = false;
+    el.innerHTML = loading();
+    el.scrollIntoView({ behavior: 'smooth' });
+    try {
+        const d = await api('/admin/voice/calls/' + encodeURIComponent(id));
+        const c = d.call;
+        const live = c.status === 'in_progress';
+        const conv = (d.conversation || []).map(e => `<div style="margin:6px 0"><span class="lead-sub">${esc(VC_TIME(e.ts))} · ${e.kind === 'turn_user' ? 'CALLER' : 'KRIYA'}</span><div>${esc(e.text)}</div></div>`).join('') || '<p class="lead-note">No transcript (retention window passed or none recorded).</p>';
+        const trace = (d.trace || []).map(e => `<tr><td>${e.status === 'ok' ? '✓' : e.status === 'skipped' ? '◌' : '✗'}</td><td>${esc(e.name)}</td><td>${esc(e.duration_ms ?? '')} ms</td><td>${esc(JSON.stringify(e.data || {})).slice(0, 220)}</td></tr>`).join('');
+        const proofs = (d.proofs || []).map(p => `<div class="lead-note">${esc(p.name)}: verified=${esc(String((p.data || {}).verified))} — expected ${esc(JSON.stringify((p.data || {}).expected))} · read back ${esc(JSON.stringify((p.data || {}).read_back))}</div>`).join('') || '<p class="lead-note">No transaction in this call.</p>';
+        el.innerHTML = `<div class="lead-card-title">${esc(c.call_ref)} · ${badge(c.status)} · ${esc(c.language)} · quality ${esc((c.quality || {}).score ?? '—')}</div>`
+            + (live && hasPermission('VOICE_MANAGE') ? `<button type="button" class="btn btn-accent btn-sm" onclick="vcTakeover('${esc(c.id)}')">Take over (transfer to reception)</button> ` : '')
+            + `<div class="lead-grid"><div><div class="lead-card-title">What the patient asked</div><p>${esc((d.patient_request || {}).transcript || '—')}</p>${vcJson((d.patient_request || {}).understood)}`
+            + `<div class="lead-card-title" style="margin-top:12px">Why Kriya responded this way</div>${vcJson(d.why)}`
+            + `<div class="lead-card-title" style="margin-top:12px">Proof of action</div>${proofs}`
+            + (c.handoff_packet ? `<div class="lead-card-title" style="margin-top:12px">Handoff packet</div>${vcJson(c.handoff_packet)}` : '')
+            + `</div><div><div class="lead-card-title">Conversation</div>${conv}</div></div>`
+            + `<div class="lead-card-title" style="margin-top:12px">Action trace</div><div class="table-wrap"><table><tbody>${trace || '<tr><td>No tool calls.</td></tr>'}</tbody></table></div>`;
+    } catch (e) { el.innerHTML = emptyState('warning', esc(e.message)); }
+}
+
+async function vcTakeover(id) {
